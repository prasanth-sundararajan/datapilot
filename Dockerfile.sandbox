# Sandbox image for running AI-written analysis code (used when "Run code in Docker" is on).
#   docker build -t datapilot-sandbox -f Dockerfile.sandbox .
FROM python:3.11-slim
RUN pip install --no-cache-dir pandas==2.2.3 numpy==2.1.3 matplotlib openpyxl
RUN useradd -m runner
USER runner
WORKDIR /workspace
