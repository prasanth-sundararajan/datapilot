# Copy your reviewLens .env here as datapilot/.env, or fill in ONE key below.
# The provider is auto-detected from whichever key is set (or force it with LLM_PROVIDER).

OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Optional overrides
# LLM_PROVIDER=openai        # openai | anthropic | groq | gemini | openrouter | ollama
# LLM_MODEL=gpt-4.1          # tested best: gpt-4.1 (gpt-4o-mini often gives vague answers)
# LLM_BASE_URL=              # any OpenAI-compatible endpoint
# EXEC_TIMEOUT=60            # seconds per code run
# SANDBOX_DIR=               # where AI-written code runs (default: ./sandbox)
# DOCKER_IMAGE=datapilot-sandbox:latest
MAX_RUNS_PER_DAY=3           # live agent runs per day (resets at midnight IST); 0 = no limit; demo mode not counted
# PLANNER_MODEL= / CODER_MODEL= / REVIEWER_MODEL=   # optional per-agent model overrides

# Guardrails (guardrails.py); defaults shown
# MAX_UPLOAD_MB=10  MAX_ROWS=200000  MAX_COLUMNS=100  MAX_SHEETS=10  MAX_QUESTION_CHARS=500
# MAX_AGENT_MESSAGES=24      # hard cap on "stop after N messages"
# LLM_MAX_TOKENS=4096        # max output tokens per model call
# RUN_TIMEOUT_SECONDS=300    # whole agent run
# MAX_RUNS_PER_HOUR=5        # per visitor (IP); 0 = off
# EXEC_CPU_SECONDS=60  EXEC_MEMORY_MB=1536  EXEC_MAX_FILE_MB=50  MAX_OUTPUT_CHARS=6000   # per code run
